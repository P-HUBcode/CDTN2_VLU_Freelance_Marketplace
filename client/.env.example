# ==============================================================================
# STUDENTHUB - CLIENT ENVIRONMENT CONFIGURATION
# Supabase Database & Authentication Credentials
# ==============================================================================

# URL dự án Supabase của bạn (Lấy trong Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key (Lấy trong Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
