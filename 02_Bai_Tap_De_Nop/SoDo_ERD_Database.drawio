        <mxCell id="tbl_jobs_body" parent="tbl_jobs" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontColor=#222222;lineHeight=1.4;" value="🔑 &lt;b&gt;id&lt;/b&gt;: INT (PK, Auto Increment)&lt;br&gt;🔗 &lt;b&gt;employer_id&lt;/b&gt;: INT (FK -&gt; employer.id)&lt;br&gt;🔗 &lt;b&gt;category_id&lt;/b&gt;: INT (FK -&gt; category.id)&lt;br&gt;• &lt;b&gt;title&lt;/b&gt;: VARCHAR(200) (Tiêu đề tin)&lt;br&gt;• &lt;b&gt;description&lt;/b&gt;: TEXT (Mô tả công việc)&lt;br&gt;• &lt;b&gt;requirements&lt;/b&gt;: TEXT (Yêu cầu kỹ năng)&lt;br&gt;• &lt;b&gt;job_type&lt;/b&gt;: ENUM('part_time', 'freelance')&lt;br&gt;• &lt;b&gt;salary_amount&lt;/b&gt;: DECIMAL(12,2)&lt;br&gt;• &lt;b&gt;salary_unit&lt;/b&gt;: ENUM('hourly', 'daily', 'monthly')&lt;br&gt;• &lt;b&gt;district&lt;/b&gt;: VARCHAR(50) (Quận/Huyện)&lt;br&gt;• &lt;b&gt;deadline&lt;/b&gt;: DATE (Hạn nộp hồ sơ)&lt;br&gt;• &lt;b&gt;status&lt;/b&gt;: ENUM('pending', 'approved', 'closed')&lt;br&gt;• &lt;b&gt;created_at&lt;/b&gt;: DATETIME" vertex="1">
