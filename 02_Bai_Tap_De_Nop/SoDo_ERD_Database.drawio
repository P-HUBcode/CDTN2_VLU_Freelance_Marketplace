        <mxCell id="tbl_apps_body" parent="tbl_apps" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontColor=#222222;lineHeight=1.4;" value="🔑 &lt;b&gt;id&lt;/b&gt;: INT (PK, Auto Increment)&lt;br&gt;🔗 &lt;b&gt;job_id&lt;/b&gt;: INT (FK -&gt; jobs.id)&lt;br&gt;🔗 &lt;b&gt;student_id&lt;/b&gt;: INT (FK -&gt; student_profiles.id)&lt;br&gt;• &lt;b&gt;cover_letter&lt;/b&gt;: TEXT (Lời nhắn ứng tuyển)&lt;br&gt;• &lt;b&gt;cv_file_url&lt;/b&gt;: VARCHAR(255) [Link PDF Cloud]&lt;br&gt;• &lt;b&gt;status&lt;/b&gt;: ENUM('submitted', 'accepted', 'rejected')&lt;br&gt;• &lt;b&gt;applied_at&lt;/b&gt;: DATETIME&lt;br&gt;• &lt;b&gt;updated_at&lt;/b&gt;: DATETIME" vertex="1">
