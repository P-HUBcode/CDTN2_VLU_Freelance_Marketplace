        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003366;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;strokeColor=#002244;shadow=1;" value="SƠ ĐỒ CƠ SỞ DỮ LIỆU QUAN HỆ (ENTITY RELATIONSHIP DIAGRAM - ERD)&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Đề tài: Nền tảng quản lý freelance / marketplace việc làm part-time cho sinh viên&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="1040" x="60" y="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl_users" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#003366;fontColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;shadow=1;" value="users (Tài khoản người dùng)" vertex="1">
          <mxGeometry height="245" width="280" x="60" y="95" as="geometry" />
        </mxCell>
        <mxCell id="tbl_users_body" parent="tbl_users" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontColor=#222222;lineHeight=1.4;" value="🔑 &lt;b&gt;id&lt;/b&gt;: INT (PK, Auto Increment)&lt;br&gt;• &lt;b&gt;email&lt;/b&gt;: VARCHAR(150) [UNIQUE]&lt;br&gt;• &lt;b&gt;password_hash&lt;/b&gt;: VARCHAR(255)&lt;br&gt;• &lt;b&gt;full_name&lt;/b&gt;: VARCHAR(100)&lt;br&gt;• &lt;b&gt;phone&lt;/b&gt;: VARCHAR(20)&lt;br&gt;• &lt;b&gt;role&lt;/b&gt;: ENUM('student', 'employer', 'admin')&lt;br&gt;• &lt;b&gt;is_verified&lt;/b&gt;: BOOLEAN [Default: false]&lt;br&gt;• &lt;b&gt;avatar_url&lt;/b&gt;: VARCHAR(255)&lt;br&gt;• &lt;b&gt;created_at&lt;/b&gt;: DATETIME" vertex="1">
          <mxGeometry height="213" width="280" y="30" as="geometry" />
        </mxCell>
        <mxCell id="tbl_student" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#003366;fontColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;shadow=1;" value="student_profiles (Hồ sơ Sinh viên)" vertex="1">
