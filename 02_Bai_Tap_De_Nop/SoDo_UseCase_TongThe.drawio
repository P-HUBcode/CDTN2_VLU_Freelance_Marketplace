<mxfile host="app.diagrams.net" modified="2026-10-16" version="24.0.0" type="device"><diagram id="page_overall" name="1. Use Case Tổng Thể"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="&lt;b&gt;SƠ ĐỒ USE CASE TỔNG THỂ (OVERALL USE CASE DIAGRAM)&lt;/b&gt;&lt;br&gt;Đề tài: Nền tảng quản lý freelance / marketplace việc làm part-time cho sinh viên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003366;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;strokeColor=#002244;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="20" width="1040" height="50" as="geometry" /></mxCell><mxCell id="b1" value="HỆ THỐNG MARKETPLACE VIỆC LÀM SINH VIÊN" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#F8F9FA;strokeColor=#003366;strokeWidth=1.5;fontColor=#003366;fontSize=12;fontStyle=1;rounded=1;" parent="1" vertex="1"><mxGeometry x="240" y="90" width="680" height="680" as="geometry" /></mxCell><mxCell id="act_sv" value="Sinh viên&#10;(Student)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#003366;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#003366;" parent="1" vertex="1"><mxGeometry x="90" y="240" width="40" height="80" as="geometry" /></mxCell><mxCell id="act_ntd" value="Nhà tuyển dụng&#10;(Employer)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#003366;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#003366;" parent="1" vertex="1"><mxGeometry x="90" y="520" width="40" height="80" as="geometry" /></mxCell><mxCell id="act_ad" value="Quản trị viên&#10;(Admin)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#003366;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#003366;" parent="1" vertex="1"><mxGeometry x="990" y="380" width="40" height="80" as="geometry" /></mxCell><mxCell id="uc_01" value="UC-01: Đăng ký / Đăng nhập (JWT)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F1F5;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="450" y="130" width="260" height="45" as="geometry" /></mxCell><mxCell id="uc_02" value="UC-02: Xác thực email SV (@vlu.edu.vn)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="200" width="270" height="45" as="geometry" /></mxCell><mxCell id="uc_03" value="UC-03: Quản lý hồ sơ, kỹ năng &amp; CV PDF" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="265" width="270" height="45" as="geometry" /></mxCell><mxCell id="uc_07" value="UC-07: Tìm kiếm &amp; Lọc việc theo ca/lương" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="330" width="270" height="45" as="geometry" /></mxCell><mxCell id="uc_08" value="UC-08: Nộp hồ sơ ứng tuyển việc làm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="395" width="270" height="45" as="geometry" /></mxCell><mxCell id="uc_10" value="UC-10: Nhận thông báo trạng thái ứng tuyển" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="460" width="270" height="45" as="geometry" /></mxCell><mxCell id="uc_04" value="UC-04: Cập n