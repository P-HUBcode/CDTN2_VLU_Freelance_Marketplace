ometry" /></mxCell><mxCell id="l_e_uc_01" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ntd" target="uc_01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_e_uc_04" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ntd" target="uc_04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_e_uc_05" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ntd" target="uc_05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_e_uc_06" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ntd" target="uc_06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_e_uc_09" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ntd" target="uc_09"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_e_uc_11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ntd" target="uc_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_e_uc_12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ntd" target="uc_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_a_uc_01" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ad" target="uc_01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_a_uc_13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ad" target="uc_13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_a_uc_14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ad" target="uc_14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_a_uc_12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E78;strokeWidth=1.5;" parent="1" edge="1" source="act_ad" target="uc_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_uc_box" value="BẢNG CHÚ THÍCH SƠ ĐỒ USE CASE TỔNG THỂ" style="swimlane;startSize=26;horizontal=1;rounded=1;arcSize=6;html=1;whiteSpace=wrap;collapsible=0;fillColor=#F8F9FA;strokeColor=#003366;strokeWidth=1.5;fontColor=#003366;fontSize=11;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="240" y="790" width="680" height="90" as="geometry" /></mxCell><mxCell id="legend_uc_text" value="&lt;b&gt;• 👤 Actor (Tác nhân):&lt;/b&gt; Sinh viên (Tìm việc), Nhà tuyển dụng (Tuyển dụng &amp; Duyệt hồ sơ), Quản trị viên (Kiểm duyệt tin &amp; Khóa vi phạm)&lt;br&gt;&lt;b&gt;• ⬭ Hình Oval (Use Case):&lt;/b&gt; Chức năng hệ thống (Xanh nhạt: Auth/Profile; Vàng: Đánh giá 2 chiều; Cam: Phân hệ Admin)&lt;br&gt;&lt;b&gt;• ── Đường nét liền:&lt;/b&gt; Mối quan hệ tương tác trực tiếp giữa Actor và chức năng tương ứng trong phạm vi hệ thống&lt;br&gt;&lt;b&gt;• SVTH:&lt;/b&gt; Hà Đại Vĩ &amp; Nguyễn Minh Phú — &lt;b&gt;GVHD:&lt;/b&gt; ThS. Nguyễn Văn Trung (Đại học Văn Lang)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;lineHeight=1.4;" parent="legend_uc_box" vertex="1"><mxGeometry x="0" y="26" width="680" height="64" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page_sv" name="2. Phân Rã - Sinh Viên"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t2" value="&lt;b&gt;SƠ ĐỒ USE CASE PHÂN RÃ: PHÂN HỆ SINH VIÊN (STUDENT SUBSYSTEM)&lt;/b&gt;&lt;br&gt;Người thực hiện thiết kế: Hà Đại Vĩ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003366;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="60" y="20" width="1040" height="50" as="geometry" /></mxCell><mxCell id="b2" value="PHÂN HỆ NGƯỜI TÌM VIỆC (SINH VIÊN)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#F2F4F7;strokeColor=#003366;strokeWidth=1.5;fontColor=#003366;fontSize=12;fontStyle=1;rounded=1;" parent="1" vertex="1"><mxGeometry x="240" y="90" width="780" height="650" as="geometry" /></mxCell><mxCell id="act_sv_2" value="Sinh viên&#10;(Student)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#003366;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#003366;" parent="1" vertex="1"><mxGeometry x="90" y="340" width="40" height="80" as="geometry" /></mxCell><mxCell id="sv_uc1" value="Đăng ký tài khoản Sinh viên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="130" width="250" height="45" as="geometry" /></mxCell><mxCell id="sv_uc1_inc" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;br&gt;Xác thực email (@vlu.edu.vn)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F1F5;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="620" y="130" width="240" height="45" as="geometry" /></mxCell><mxCell id="sv_uc2" value="Quản lý Hồ sơ năng lực (Profile)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="210" width="250" height="45" as="geometry" /></mxCell><mxCell id="sv_uc2_ext" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;br&gt;Upload file CV PDF lên Cloud" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="620" y="210" width="240" height="45" as="geometry" /></mxCell><mxCell id="sv_uc3" value="Tìm kiếm &amp; Lọc việc làm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="310" width="250" height="45" as="geometry" /></mxCell><mxCell id="sv_uc3_sub1" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;br&gt;Lọc theo Quận/Huyện" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="620" y="280" width="240" height="40" as="geometry" /></mxCell><mxCell id="sv_uc3_sub2" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;br&gt;Lọc theo Mức lương &amp; Ca rảnh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="620" y="340" width="240" height="40" as="geometry" /></mxCell><mxCell id="sv_uc4" value="Nộp đơn ứng tuyển việc làm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="280" y="420" width="250" height="45" as="geometry" /></mxCell><mxCell id="sv_uc4_inc" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;br&gt;Gửi Cover Letter &amp; Chọn CV" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F1F5;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000000;shadow=1;" parent="1" vertex="1"><mxGeometry x="620" y="420" width="240" height="45" as="geometry" /></mxCell><mxCell id="sv_uc5" value="Theo dõi trạng thái &amp; Thông báo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;strokeWidth=1.5;fontSize=11;fontColor=#000