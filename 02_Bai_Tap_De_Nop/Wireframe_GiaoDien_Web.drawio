        <mxCell id="p_info" value="&lt;b&gt;Nguyễn Minh Phú&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;background-color:#DCFCE7;color:#166534;font-size:9px;padding:3px;border-radius:3px;&quot;&gt;✔️ ĐÃ XÁC THỰC VLU&lt;/span&gt;&lt;br&gt;MSSV: &lt;b&gt;2374802013447&lt;/b&gt;&lt;br&gt;Trường: &lt;b&gt;Đại học Văn Lang&lt;/b&gt; &amp;nbsp;•&amp;nbsp; Khoa: CNTT&lt;br&gt;Email: &lt;i&gt;sinhvien.demo@student.vlu.edu.vn&lt;/i&gt;&lt;br&gt;SĐT: 0911223344&lt;br&gt;Đánh giá uy tín: ⭐⭐⭐⭐⭐ &lt;b&gt;5.0 / 5.0&lt;/b&gt; (4 việc làm thành công)" style="rounded=0;fillColor=none;strokeColor=none;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="175" y="145" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p_bio" value="&lt;b&gt;Giới thiệu bản thân:&lt;/b&gt;&lt;br&gt;Sinh viên năm cuối ngành CNTT, có đam mê và kinh nghiệm phát triển Web với ReactJS, Node.js, MySQL. Đã từng làm trợ giảng và tham gia 2 dự án freelance ngắn hạn." style="rounded=1;fillColor=#F9FAFB;strokeColor=#E5E7EB;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="80" y="240" width="420" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p_skills" value="&lt;b&gt;Kỹ năng chuyên môn (Skills Tags):&lt;/b&gt;&lt;br&gt;[ ReactJS ] &amp;nbsp; [ Node.js ] &amp;nbsp; [ MySQL ] &amp;nbsp; [ TailwindCSS ] &amp;nbsp; [ Git ] &amp;nbsp; [ Figma ]" style="rounded=0;fillColor=none;strokeColor=none;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="80" y="315" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_cv_box" value="&lt;b&gt;📄 File CV PDF đính kèm:&lt;/b&gt;&lt;br&gt;Tên tệp: &lt;b&gt;CV_NguyenMinhPhu_WebDev.pdf&lt;/b&gt; (1.8 MB)&lt;br&gt;Cập nhật: 15/10/2026 &amp;nbsp;•&amp;nbsp; Đã lưu trữ an toàn trên Cloudinary&lt;br&gt;[👁️ Xem CV online]&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[📥 Tải xuống]&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[🔄 Tải CV mới]" style="rounded=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontSize=10;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="80" y="365" width="420" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p_btn_update" value="✏️ Chỉnh sửa hồ sơ cá nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003366;fontColor=#FFFFFF;fontSize=10;fontStyle=1;strokeColor=#002244;align=center;" parent="1" vertex="1">
          <mxGeometry x="80" y="465" width="420" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p_hist" value="&lt;b&gt;LỊCH SỬ VIỆC LÀM &amp; ĐÁNH GIÁ TỪ NHÀ TUYỂN DỤNG&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;1. Thực tập sinh Lập trình Web — Công ty Sáng tạo VLU&lt;/b&gt;&lt;br&gt;⭐ 5.0/5 &amp;nbsp;•&amp;nbsp; &lt;i&gt;&quot;Phú làm việc rất chăm chỉ, nắm bắt React nhanh và bàn giao code đúng hẹn!&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Nhân viên Hỗ trợ Sự kiện Chào Tân Sinh viên VLU&lt;/b&gt;&lt;br&gt;⭐ 5.0/5 &amp;nbsp;•&amp;nbsp; &lt;i&gt;&quot;Nhiệt tình, đúng giờ, giao tiếp tốt với các bạn sinh viên mới.&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Hỗ trợ nhập liệu CSDL Shop Thời trang Chic&lt;/b&gt;&lt;br&gt;⭐ 5.0/5 &amp;nbsp;•&amp;nbsp; &lt;i&gt;&quot;Cẩn thận, chính xác, hoàn thành trước hạn bàn giao.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" parent="1" vertex="1">
