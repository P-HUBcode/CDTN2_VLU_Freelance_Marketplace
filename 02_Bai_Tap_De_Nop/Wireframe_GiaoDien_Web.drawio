  <diagram id="page_detail" name="2. Chi Tiết Việc &amp; Nộp Đơn">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="850" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_frame" value="🌐 VLU Freelance Marketplace — Chi tiết việc làm &amp; Nộp hồ sơ" style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#374151;fontSize=11;fontStyle=1;rounded=1;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1080" height="710" as="geometry" />
        </mxCell>
        <mxCell id="d_nav" value="&lt;b&gt;🎓 VLU FREELANCE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Trang chủ &amp;gt; Lập trình &amp; CNTT &amp;gt; &lt;b&gt;Tuyển Thực Tập Sinh ReactJS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#003366;fontColor=#ffffff;fontSize=11;fontStyle=1;strokeColor=#002244;align=left;spacingLeft=15;" parent="1" vertex="1">
          <mxGeometry x="40" y="50" width="1080" height="45" as="geometry" />
        </mxCell>
        <mxCell id="d_main" value="&lt;b&gt;TUYỂN THỰC TẬP SINH LẬP TRÌNH FRONTEND REACTJS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#003366;font-weight:bold;&quot;&gt;Công ty TNHH Truyền thông Sáng tạo VLU&lt;/span&gt; (⭐ 4.9/5 - 18 đánh giá)&lt;br&gt;📍 Địa chỉ: 69/68 Đặng Thùy Trâm, P. 13, Bình Thạnh, TP.HCM &amp;nbsp;•&amp;nbsp; 💰 Mức lương: &lt;b&gt;45.000đ / giờ&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;1. Mô tả công việc:&lt;/b&gt;&lt;br&gt;- Phối hợp cùng team xây dựng giao diện người dùng bằng ReactJS và TailwindCSS.&lt;br&gt;- Tối ưu hóa hiển thị trên thiết bị di động (Mobile Responsive).&lt;br&gt;- Hỗ trợ ghép nối RESTful API với Backend server.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Yêu cầu ứng viên:&lt;/b&gt;&lt;br&gt;- Là sinh viên năm 3 hoặc năm cuối chuyên ngành CNTT trường Đại học Văn Lang.&lt;br&gt;- Nắm vững kiến thức HTML5, CSS3, JavaScript ES6 và React cơ bản.&lt;br&gt;- Có thái độ chủ động, tinh thần học hỏi cao.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Quyền lợi:&lt;/b&gt;&lt;br&gt;- Thù lao theo giờ rõ ràng, nhận lương định kỳ theo tuần hoặc theo tháng.&lt;br&gt;- Hỗ trợ mộc và đóng dấu báo cáo thực tập tốt nghiệp.&lt;br&gt;- Lịch làm việc linh hoạt, được đăng ký ca làm theo thời khóa biểu học tập." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="105" width="560" height="535" as="geometry" />
        </mxCell>
        <mxCell id="d_modal" value="&lt;b&gt;📝 FORM NỘP HỒ SƠ ỨNG TUYỂN (MODAL 1-CHẠM)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Thông tin ứng viên (Tự động điền từ Profile):&lt;/b&gt;&lt;br&gt;• Họ và tên: &lt;b&gt;Nguyễn Minh Phú&lt;/b&gt;&lt;br&gt;• MSSV: &lt;b&gt;2374802013447&lt;/b&gt; &amp;nbsp;•&amp;nbsp; Ngành: Công nghệ Thông tin&lt;br&gt;• Email: &lt;i&gt;sinhvien.demo@student.vlu.edu.vn&lt;/i&gt; (Đã xác thực)&lt;br&gt;• Điểm uy tín sinh viên: ⭐ &lt;b&gt;5.0 / 5.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Chọn CV ứng tuyển:&lt;/b&gt;&lt;br&gt;(o) Sử dụng CV PDF đã có trong Profile: &lt;u&gt;CV_NguyenMinhPhu_WebDev.pdf&lt;/u&gt;&lt;br&gt;( ) Tải lên CV mới từ máy tính (.pdf, max 5MB)&lt;br&gt;&lt;br&gt;&lt;b&gt;Lời nhắn gửi Nhà tuyển dụng (Cover Letter):&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" parent="1" vertex="1">
          <mxGeometry x="640" y="105" width="460" height="535" as="geometry" />
        </mxCell>
