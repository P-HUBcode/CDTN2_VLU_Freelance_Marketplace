<mxfile host="app.diagrams.net" modified="2026-10-16" agent="Mozilla/5.0" version="24.0.0" type="device"><diagram id="KienTrucHeThong" name="Kiến Trúc Hệ Thống"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;SƠ ĐỒ KIẾN TRÚC HỆ THỐNG TỔNG THỂ (3-TIER LAYERED ARCHITECTURE)&lt;/b&gt;&lt;br&gt;Đề tài: Nền tảng quản lý freelance / marketplace việc làm part-time cho sinh viên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003366;fontColor=#ffffff;fontSize=14;align=center;strokeColor=#002244;shadow=1;" parent="1" vertex="1"><mxGeometry x="80" y="20" width="1000" height="50" as="geometry" /></mxCell><mxCell id="tier1_bg" value="&lt;b&gt;1. PRESENTATION LAYER (TẦNG GIAO DIỆN CLIENT)&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=10;html=1;whiteSpace=wrap;collapsible=0;fillColor=#E8F1F5;strokeColor=#003366;fontColor=#003366;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="80" y="90" width="1000" height="110" as="geometry" /></mxCell><mxCell id="c_ui" value="&lt;b&gt;Web Application (Desktop &amp; Mobile Responsive)&lt;/b&gt;&lt;br&gt;ReactJS / Next.js + TailwindCSS&lt;br&gt;• Quản lý giao diện Sinh viên, NTD &amp; Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;fontSize=11;shadow=1;" parent="1" vertex="1"><mxGeometry x="110" y="130" width="420" height="60" as="geometry" /></mxCell><mxCell id="c_state" value="&lt;b&gt;State &amp; API Client Manager&lt;/b&gt;&lt;br&gt;Axios / React Query + Context API&lt;br&gt;• Quản lý Session, Cache &amp; Gọi HTTP Requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#003366;fontSize=11;shadow=1;" parent="1" vertex="1"><mxGeometry x="580" y="130" width="470" height="60" as="geometry" /></mxCell><mxCell id="tier2_bg" value="&lt;b&gt;2. SECURITY &amp; API GATEWAY LAYER (TẦNG BẢO MẬT &amp; ĐIỀU PHỐI)&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=10;html=1;whiteSpace=wrap;collapsible=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#B46500;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="80" y="230" width="1000" height="90" as="geometry" /></mxCell><mxCell id="sec_jwt" value="&lt;b&gt;JWT Authentication &amp; Authorization Filter&lt;/b&gt;&lt;br&gt;• Xác thực Token &amp; Phân quyền Role: Student / Employer / Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D6B656;fontSize=11;shadow=1;" parent="1" vertex="1"><mxGeometry x="110" y="265" width="420" height="45" as="geometry" /></mxCell><mxCell id="sec_cors" value="&lt;b&gt;Security Middleware: CORS &amp; Rate Limiter&lt;/b&gt;&lt;br&gt;• Chặn tấn công Spam Requests &amp; Cấu hình Domain an toàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D6B656;fontSize=11;shadow=1;" parent="1" vertex="1"><mxGeometry x="580" y="265" width="470" height="45" as="geometry" /></mxCell><mxCell id="tier3_bg" value="&lt;b&gt;3. BUSINESS LOGIC LAYER (TẦNG XỬ LÝ NGHIỆP VỤ - BACKEND REST API)&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=10;html=1;whiteSpace=wrap;collapsible=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#603B77;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="80" y="350" width="1000" height="210" as="geometry" /></mxCell><mxCell id="ctrl_box" value="&lt;b&gt;Controllers (REST API Endpoints)&lt;/b&gt;&lt;br&gt;• AuthController • JobController • ApplicationController • ReviewController • AdminController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673A6;fontSize=11;shadow=1;" parent="1" vertex="1"><mxGeometry x="110" y="390" width="940" height="45" as="geometry" /></mxCell><mxCell id="srv_auth" value="&lt;b&gt;Auth &amp; User Service&lt;/b&gt;&lt;br&gt;• Mã hóa Bcrypt&lt;br&gt;• Xác thực Email SV&lt;br&gt;• Sinh JWT Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673A6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="110" y="455" width="170" height="85" as="geometry" /></mxCell><mxCell id="srv_job" value="&lt;b&gt;Job &amp; Search Service&lt;/b&gt;&lt;br&gt;• Đăng &amp; quản lý tin&lt;br&gt;• Bộ lọc việc đa tiêu chí&lt;br&gt;• Đóng/Mở tin tuyển dụng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673A6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="300" y="455" width="175" height="85" as="geometry" /></mxCell><mxCell id="srv_apply" value="&lt;b&gt;Application Service&lt;/b&gt;&lt;br&gt;• Nộp đơn ứng tuyển&lt;br&gt;• Upload &amp; gắn link CV&lt;br&gt;• NTD Duyệt/Từ chối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673A6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="495" y="455" width="180" height="85" as="geometry" /></mxCell><mxCell id="srv_rev" value="&lt;b&gt;Review &amp; Rating Service&lt;/b&gt;&lt;br&gt;• Chấm sao 2 chiều&lt;br&gt;• Tính điểm uy tín TB&lt;br&gt;• Gửi thông báo kết quả" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673A6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="695" y="455" width="175" height="85" as="geometry" /></mxCell><mxCell id="srv_admin" value="&lt;b&gt;Admin Service&lt;/b&gt;&lt;br&gt;• Duyệt tin tuyển dụng&lt;br&gt;• Khóa tài khoản vi phạm&lt;br&gt;• Xử lý Report lừa đảo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673A6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="890" y="455" width="160" height="85" as="geometry" /></mxCell><mxCell id="tier4_bg" value="&lt;b&gt;4. DATA ACCESS &amp; STORAGE LAYER (TẦNG LƯU TRỮ &amp; TRUY XUẤT DỮ LIỆU)&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=10;html=1;whiteSpace=wrap;collapsible=0;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D6013;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="80" y="590" width="1000" height="140" as="geometry" /></mxCell><mxCell id="da_orm" value="&lt;b&gt;Data Access &amp; ORM&lt;/b&gt;&lt;br&gt;Prisma / Sequelize / Spring Data&lt;br&gt;• Ánh xạ CSDL &amp; Quản lý Transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;fontSize=11;shadow=1;" parent="1" vertex="1"><mxGeometry x="110" y="635" width="340" height="75" as="geometry" /></mxCell><mxCell id="db_main" value="&lt;b&gt;Primary Database&lt;/b&gt;&lt;br&gt;MySQL / PostgreSQL&lt;br&gt;• Bảng: Users, Jobs, Applications, Reviews" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#82B366;fontSize=11;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="490" y="630" width="250" height="85" as="geometry" /></mxCell><mxCell id="cloud_storage" value="&lt;b&gt;Cloud Object Storage&lt;/b&gt;&lt;br&gt;Cloudinary / Firebase Storage&lt;br&gt;• Lưu trữ File CV PDF &amp; Ảnh Thẻ SV" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;fontSize=11;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="780" y="630" width="270" height="85" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E78;fontSize=11;fontColor=#1F4E78;" parent="1" edge="1" source="c_ui" target="c_state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="HTTPS / JSON Request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E78;fontSize=11;fontColor=#1F4E78;" parent="1" edge="1" source="c_state" target="tier2_bg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Authorized &amp; Rate-checked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E78;fontSize=11;fontColor=#1F4E78;" parent="1" edge="1" source="tier2_bg" target="ctrl_box"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E78;fontSize=11;fontColor=#1F4E78;" parent="1" edge="1" source="ctrl_box" target="srv_job"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E78;fontSize=11;fontColor=#1F4E78;" parent="1" edge="1" source="srv_job" target="da_orm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="SQL Queries (CRUD)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E78;fontSize=11;fontColor=#1F4E78;" parent="1" edge="1" source="da_orm" target="db_main"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Upload CV / Ảnh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82B366;fontSize=11;" parent="1" edge="1" source="srv_apply" target="cloud_storage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_kt_box" value="BẢNG CHÚ THÍCH KIẾN TRÚC &amp; THÔNG TIN ĐỒ ÁN" style="swimlane;startSize=26;horizontal=1;rounded=1;arcSize=6;html=1;whiteSpace=wrap;collapsible=0;fillColor=#F8F9FA;strokeColor=#003366;strokeWidth=1.5;fontColor=#003366;fontSize=11;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="80" y="755" width="1000" height="100" as="geometry" /></mxCell><mxCell id="legend_kt_left" value="&lt;b&gt;• 🟦 &lt;font color=&quot;#003366&quot;&gt;Presentation Layer:&lt;/font&gt;&lt;/b&gt; Giao diện Web Client (ReactJS + TailwindCSS, Responsive Mobile &amp; Desktop)&lt;br&gt;&lt;b&gt;• 🟨 &lt;font color=&quot;#B46500&quot;&gt;Security Gateway:&lt;/font&gt;&lt;/b&gt; Lớp bảo vệ xác thực JWT Token, CORS &amp; Bộ lọc phân quyền Role&lt;br&gt;&lt;b&gt;• 🟪 &lt;font color=&quot;#603B77&quot;&gt;Business Logic:&lt;/font&gt;&lt;/b&gt; Backend REST API (Node.js Express), Controllers điều phối Services xử lý nghiệp vụ&lt;br&gt;&lt;b&gt;• 🟩 &lt;font color=&quot;#2D6013&quot;&gt;Data &amp; Cloud Storage:&lt;/font&gt;&lt;/b&gt; CSDL quan hệ MySQL 8.0 &amp; Cloudinary lưu file CV PDF, ảnh thẻ" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;lineHeight=1.4;" parent="legend_kt_box" vertex="1"><mxGeometry x="0" y="26" width="540" height="74" as="geometry" /></mxCell><mxCell id="legend_kt_right" value="&lt;b&gt;• Đề tài:&lt;/b&gt; Nền tảng quản lý freelance / marketplace việc làm part-time cho sinh viên&lt;br&gt;&lt;b&gt;• SVTH 1:&lt;/b&gt; Nguyễn Minh Phú (MSSV: 2374802013447) — Phụ trách Backend, Database &amp; Kiến trúc&lt;br&gt;&lt;b&gt;• SVTH 2:&lt;/b&gt; Hà Đại Vĩ (MSSV: 2374802010551) — Phụ trách Frontend, Wireframe UI/UX &amp; Use Case&lt;br&gt;&lt;b&gt;• GVHD:&lt;/b&gt; ThS. Nguyễn Văn Trung — Khoa Công nghệ Thông tin, Trường Đại học Văn Lang" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;lineHeight=1.4;" parent="legend_kt_box" vertex="1"><mxGeometry x="540" y="26" width="460" height="74" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>